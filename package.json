{
  "name": "remilia-content",
  "private": true,
  "version": "0.0.0",
  "description": "Sanity studio for the Remilia content graph (org / com / net sections)",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy:studio": "sanity deploy",
    "bake:org": "pnpm --filter @remilia/hosts bake:org",
    "bake": "pnpm --filter @remilia/hosts bake",
    "validate": "sanity schema validate",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test",
    "bake:com": "pnpm --filter @remilia/hosts bake:com",
    "bake:net": "pnpm --filter @remilia/hosts bake:net"
  },
  "devDependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/vision": "^6.11.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.11.0",
    "styled-components": "^6.1.18",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@<4": ">=3.15.2",
      "smol-toml": ">=1.7.1",
      "uuid": ">=11.1.1",
      "adm-zip": ">=0.6.1"
    }
  }
}
