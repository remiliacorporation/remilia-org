{
  "name": "@remilia/hosts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Per-host chrome (header/footer + theme.css) and bake entries; core/ holds the shared blog component system.",
  "scripts": {
    "bake:org": "node --import tsx org/bake.ts",
    "import:md": "node --import tsx md-import.ts",
    "import:ghost": "node --import tsx ghost-import.ts",
    "import:paragraph": "node --import tsx paragraph-import.ts",
    "import:substack": "node --import tsx substack-import.ts",
    "dev": "node --watch-path=./ --watch-path=../packages --watch --import tsx preview.ts org /tmp/org-bake --serve",
    "preview": "node --import tsx preview.ts org /tmp/org-bake --serve"
  },
  "dependencies": {
    "@remilia/renderer": "workspace:*",
    "@remilia/seo": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.8.2"
  }
}
